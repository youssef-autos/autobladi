NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash-lite)
GEMINI_MODEL=
# OpenAI / ChatGPT — used when the admin selects "ChatGPT" as the AI provider.
OPENAI_API_KEY=
# Optional: override the OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=
# Qwen (Alibaba DashScope, qwen.ai) — used when the admin selects "Qwen".
# OpenAI-compatible API; get a DashScope API key from https://qwen.ai
QWEN_API_KEY=
# Optional: override the Qwen model (default: qwen-plus)
QWEN_MODEL=
# Optional: override the Qwen base URL (default: international/Singapore endpoint)
QWEN_BASE_URL=
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=
# Shared secret protecting the daily cron route /api/cron/subscription-grace
CRON_SECRET=
# IndexNow key (random hex) — instant indexing pings to Bing/Yandex
INDEXNOW_KEY=
